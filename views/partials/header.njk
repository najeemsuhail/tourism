<div class="notification-bar">
  🎉 Special Offer: Book now and get 10% off on all houseboats! 🎉
</div>


<header>
  <div class="header-top">
  <a href="/" class="logo">
      <img src="/images/logo.jpeg" alt="Hello Alleppey Logo">
    </a>

  <div class="menu-toggle" onclick="document.querySelector('nav').classList.toggle('active')">☰ Menu</div>

  <nav>
    <a href="/">Home</a>
    <a href="/about">About Us</a>

{# Dynamic categories menu #}
{% for category in categories %}
  <div class="menu-item">
    <a href="/listings/{{ category.name }}">{{ category.name }}</a>

    {% if category.subcategories.length > 0 %}
      <span class="submenu-toggle mobile-only">▼</span>

      <div class="submenu">
        {% for sub in category.subcategories %}
          <a href="/listings/{{ category.name }}/{{ sub.name }}">{{ sub.name }}</a>
        {% endfor %}
      </div>
    {% endif %}
  </div>
{% endfor %}
  
  <div class="menu-item">
    <a href="/booking">Bookings</a>
  </div>

     <a href="/contact">Contact Us</a> 
  </nav>
  </div>
</header>