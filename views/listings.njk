{% extends "layouts/base.njk" %}

{% block title %}Listings - Hello Alleppey{% endblock %}

{% block content %}

<div class="admin-container">
  
<h2>All Listings</h2>

<form method="POST" action="/listings/add" class="add-form">
  <input name="name" placeholder="Name" required>
  <input name="description" placeholder="Description" required>
  <input name="price"  pattern="^[₹Rs\s]*\d+(\.\d{1,2})?$" placeholder="Price (in ₹)" required>
  <input name="image" placeholder="Image URL" required>

  <select name="categoryIds" multiple required>
    {% for cat in categories %}
      <option value="{{ cat.id }}">{{ cat.name }}</option>
    {% endfor %}
  </select>

  <select name="attributeIds" multiple>
    {% for attr in attributes %}
      <option value="{{ attr.id }}">{{ attr.name }}</option>
    {% endfor %}
  </select>

  <button type="submit">Add Listing</button>
</form>

<table class="data-table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th>Price</th>
      <th>Image</th>
      <th>Categories</th>
      <th>Attributes</th>
      <th>Update</th>
      <th>Delete</th>
    </tr>
  </thead>
  <tbody>
    {% for listing in listings %}
    <tr>
      <form method="POST" action="/listings/edit/{{ listing.id }}">
        <td><input name="name" value="{{ listing.name }}"></td>
        <td><input name="description" value="{{ listing.description }}"></td>
        <td><input name="price" pattern="^[₹Rs\s]*\d+(\.\d{1,2})?$" value="{{ listing.price }}"></td>
        <td><input name="image" value="{{ listing.image }}"></td>
        <td>
          <select name="categoryIds" multiple>
            {% for cat in categories %}
              <option value="{{ cat.id }}" {% if cat.id in listing.categoryIds %}selected{% endif %}>{{ cat.name }}</option>
            {% endfor %}
          </select>
        </td>

        <td>
            <select name="attributeIds" multiple>
              {% for attr in attributes %}
                <option value="{{ attr.id }}" {% if attr.id in listing.attributeIds %}selected{% endif %}>{{ attr.name }}</option>
              {% endfor %}
            </select>
        </td>

        <td><button type="submit" class="btn-update">Update</button></td>
      </form>
      <form method="POST" action="/listings/delete/{{ listing.id }}">
        <td><button class="btn-delete" type="submit" onclick="return confirm('Delete this listing?')">Delete</button></td>
      </form>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endblock %}

</div>
