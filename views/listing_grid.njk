{% extends "layouts/base.njk" %}

{% block title %}{{ category | capitalize }} - {{ subcategory | capitalize }} | Hello Alleppey{% endblock %}

{% block content %}
<div class="container">
  <h1>{{ category | capitalize }}{% if subcategory %} / {{ subcategory | capitalize }}{% endif %}</h1>

  <div class="grid-container">
    {% for listing in listings %}
      <a href="/listings/details/{{ listing.id }}" class="card-link">
        <div class="card">
          <img src="/images/listing/{{ listing.image }}" alt="{{ listing.name }}">
          <h3>{{ listing.name }}</h3>
          <p>{{ listing.description }}</p>
          <p><strong>₹{{ listing.price }}</strong></p>
        </div>
      </a>
    {% else %}
      <p>No listings found.</p>
    {% endfor %}
  </div>
</div>
{% endblock %}
